# Environment configuration template
#
# Copy to `.env` and fill the values. Never commit a real `.env` file.
# The server reads these from process.env (npm scripts do not load .env
# automatically — use your platform's env configuration or `node --env-file=.env`).

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=production
# Directory where the SQLite database lives (defaults to ./data)
DATA_DIR=./data
# Create demo accounts on the very first boot. Set to `off` in production.
SEED_ON_BOOT=on

# ── Authentication ────────────────────────────────────────────────────────────
# E-mail + password only (scrypt). There is no third-party identity provider, so
# there is no OAuth client id / secret to configure. Session lifetime is 14 days
# (server/auth.js) and rate limits are per-IP buckets (server/index.js).

# ── Real-time multiplayer ─────────────────────────────────────────────────────
# WebSocket runs on the same HTTP server at path /ws — no extra port or service.
# Behind a reverse proxy, remember to forward the Upgrade header:
#   proxy_set_header Upgrade $http_upgrade;
#   proxy_set_header Connection "upgrade";
